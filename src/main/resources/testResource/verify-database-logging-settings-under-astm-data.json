{
  "testCaseId": "TC-001",
  "testCaseName": "Verify Database Logging Settings under ASTM",
  "description": "Verify logging presence for different Request types and allowing error logs in customer transaction grids.",
  "priority": "Medium",
  "type": "Functional",
  "testDataCount": 110,
  "requestTypes": [
    {
      "type": "VALID",
      "valid": [
        "CREATE_ORDER",
        "UPDATE_ORDER",
        "DELETE_ORDER",
        "FETCH_STATUS",
        "CUSTOMER_TRANSACTION"
      ],
      "edgeCases": [
        "empty",
        "null",
        "special_characters",
        "max_length"
      ]
    }
  ],
  "loggingGrids": [
    {
      "grid": "maeStatus",
      "errorLogScenarios": [
        "No error",
        "Database connection timeout",
        "Invalid request type"
      ]
    },
    {
      "grid": "ebsOrderStatus",
      "errorLogScenarios": [
        "Order not found",
        "Order status update failed"
      ]
    },
    {
      "grid": "ebsBusinessEventsFailed",
      "errorLogScenarios": [
        "Business event processing failed",
        "Event queue overflow"
      ]
    },
    {
      "grid": "customerTransaction",
      "errorLogScenarios": [
        "Transaction log missing",
        "Error log present"
      ]
    }
  ],
  "expectedResults": {
    "maeStatus": {
      "displayed": true,
      "count": 10,
      "boundaryValues": [0, 1, 10, 100, 1000]
    },
    "ebsOrderStatus": {
      "displayed": true,
      "count": 5,
      "boundaryValues": [0, 1, 5, 50, 500]
    },
    "ebsBusinessEventsFailed": {
      "displayed": true,
      "count": 2,
      "boundaryValues": [0, 1, 2, 20, 200]
    }
  },
  "locators": [
    {
      "name": "maeStatusGrid",
      "type": "xpath",
      "value": "//div[@id='maeStatusGrid']"
    },
    {
      "name": "ebsOrderStatusGrid",
      "type": "xpath",
      "value": "//div[@id='ebsOrderStatusGrid']"
    },
    {
      "name": "ebsBusinessEventsFailedGrid",
      "type": "xpath",
      "value": "//div[@id='ebsBusinessEventsFailedGrid']"
    },
    {
      "name": "customerTransactionGrid",
      "type": "xpath",
      "value": "//div[@id='customerTransactionGrid']"
    },
    {
      "name": "errorLogRow",
      "type": "css",
      "value": ".error-log-row"
    }
  ],
  "edgeCases": [
    {
      "description": "Request type is empty string",
      "requestType": "",
      "expectedLog": false,
      "expectedError": true
    },
    {
      "description": "Request type is null",
      "requestType": null,
      "expectedLog": false,
      "expectedError": true
    },
    {
      "description": "Request type contains special characters",
      "requestType": "!@#$%^&*()",
      "expectedLog": false,
      "expectedError": true
    },
    {
      "description": "Request type exceeds max length",
      "requestType": "REQUEST_TYPE_EXCEEDING_MAX_LENGTH_ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
      "expectedLog": false,
      "expectedError": true
    }
  ]
}
