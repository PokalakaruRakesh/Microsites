    {"requestType": "CREATE_ORDER", "customerId": "CUST004", "orderId": "ORD001", "learnerId": null, "expectedLog": "order"},
    {"requestType": "UPDATE_ORDER", "customerId": "CUST005", "orderId": "ORD002", "learnerId": null, "expectedLog": "order"},
    {"requestType": "DELETE_ORDER", "customerId": "CUST006", "orderId": "ORD003", "learnerId": null, "expectedLog": "order"},
    {"requestType": "CREATE_LEARNER", "customerId": null, "orderId": null, "learnerId": "LEARN001", "expectedLog": "learner"},
    {"requestType": "UPDATE_LEARNER", "customerId": null, "orderId": null, "learnerId": "LEARN002", "expectedLog": "learner"},
