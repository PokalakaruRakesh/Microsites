{
  "INT-4686": {
    "TestCaseID": "INT-4686",
    "TestCaseName": "Verify user creation",
    "Objective": "Verify if user is able to register user details with any roles",
    "Priority": "Medium",
    "Type": "No Type specified",
    "ExpectedResult": "User should be able to land on Account Administration, User Management tab"
  },
  "UserCreation": {
    "fields": [
      { "name": "username", "type": "string", "required": true, "minLength": 3, "maxLength": 50 },
      { "name": "email", "type": "string", "required": true, "format": "email" },
      { "name": "password", "type": "string", "required": true, "minLength": 8, "maxLength": 64 },
      { "name": "role", "type": "string", "required": true, "allowedValues": ["Admin", "User", "Manager", "Viewer", "Guest"] },
      { "name": "firstName", "type": "string", "required": true, "minLength": 1, "maxLength": 30 },
      { "name": "lastName", "type": "string", "required": true, "minLength": 1, "maxLength": 30 },
      { "name": "phoneNumber", "type": "string", "required": false, "format": "phone" },
      { "name": "status", "type": "string", "required": false, "allowedValues": ["Active", "Inactive"] }
    ],
    "positiveData": [
