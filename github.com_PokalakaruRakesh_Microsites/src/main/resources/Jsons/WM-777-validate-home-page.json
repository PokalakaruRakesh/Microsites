{
  "WM-777": {
    "TestCaseID": "WM-777",
    "TestCaseName": "ValidateHome page",
    "Objective": "Validate that the Home page",
    "Priority": "Medium",
    "Type": "No Type specified",
    "Locators": [
      {
        "name": "Header_Main",
        "locator": "//h1[contains(text(),'Helping Our World Work Better')]",
        "type": "xpath"
      },
      {
        "name": "Main_Navigation",
        "locator": "//nav[@id='main-nav']",
        "type": "xpath"
      },
      {
        "name": "Footer",
        "locator": "//footer",
        "type": "xpath"
      },
      {
        "name": "Banner_Image",
        "locator": "//div[contains(@class,'banner-image')]",
        "type": "xpath"
      },
      {
        "name": "Search_Box",
        "locator": "//input[@type='search']",
        "type": "xpath"
      }
    ],
    "TestData": {
      "pageUrl": "https://www.example.com/home",
      "expectedHeader": "Helping Our World Work Better",
      "expectedLinks": [
        {
          "text": "About Us",
          "href": "/about",
          "expectedDestinationTitle": "About Us - Example"
        },
        {
          "text": "Standards",
          "href": "/standards",
          "expectedDestinationTitle": "Standards - Example"
        },
        {
          "text": "Membership",
          "href": "/membership",
          "expectedDestinationTitle": "Membership - Example"
        },
        {
          "text": "Contact",
          "href": "/contact",
          "expectedDestinationTitle": "Contact - Example"
        }
      ],
      "footerLinks": [
        "Privacy Policy",
        "Terms of Use",
        "Cookie Policy",
        "Accessibility"
      ],
      "mainNavLinks": [
        "Home",
        "About Us",
        "Standards",
        "Membership",
        "Contact"
      ],
      "breadcrumbTrail": [
        "Home"
      ],
      "edgeCases": [
        {
          "description": "Header missing",
          "expectedHeader": ""
        },
        {
          "description": "Header text in lowercase",
          "expectedHeader": "helping our world work better"
        },
        {
          "description": "Header partially visible",
          "expectedHeader": "Helping Our World"
        },
        {
          "description": "Header with extra whitespace",
          "expectedHeader": "  Helping Our World Work Better  "
        }
      ],
      "boundaryCases": [
        {
          "description": "Header at maximum allowed length",
          "expectedHeader": "Helping Our World Work Better" + "A".repeat(150)
        },
        {
          "description": "Header at minimum allowed length",
          "expectedHeader": "H"
        }
      ]
    },
    "ExpectedResult": "user able to see Helping Our World Work Better header"
  }
}
