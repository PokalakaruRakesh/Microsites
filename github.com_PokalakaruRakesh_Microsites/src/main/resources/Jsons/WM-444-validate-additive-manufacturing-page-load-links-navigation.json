{
  "WM-444": {
    "TestCaseID": "WM-444",
    "TestCaseName": "Validate Page Load, Presence of All Links & Navigation",
    "Objective": "Validate that the Additive Manufacturing page loads successfully, all links are displayed, and each link navigates to the correct destination when clicked",
    "Priority": "Medium",
    "Type": "UI Navigation",
    "Locators": [
      {
        "name": "mainHeader",
        "locator": "//h1[contains(text(),'Additive Manufacturing')]",
        "type": "xpath"
      },
      {
        "name": "mainNavLinks",
        "locator": "//nav[@id='main-nav']//a",
        "type": "xpath"
      },
      {
        "name": "footerLinks",
        "locator": "//footer//a",
        "type": "xpath"
      },
      {
        "name": "breadcrumbTrail",
        "locator": "//nav[@aria-label='breadcrumb']//li",
        "type": "xpath"
      },
      {
        "name": "contentLinks",
        "locator": "//section[contains(@class,'additive-manufacturing')]//a",
        "type": "xpath"
      }
    ],
    "TestData": {
      "pageUrl": "https://www.astm.org/additive-manufacturing.html",
      "expectedHeader": "Additive Manufacturing",
      "expectedLinks": [
        {
          "text": "Overview",
          "href": "/additive-manufacturing/overview.html",
          "expectedDestinationTitle": "Additive Manufacturing Overview"
        },
        {
          "text": "Standards",
          "href": "/additive-manufacturing/standards.html",
          "expectedDestinationTitle": "Additive Manufacturing Standards"
        },
        {
          "text": "Committees",
          "href": "/additive-manufacturing/committees.html",
          "expectedDestinationTitle": "Additive Manufacturing Committees"
        },
        {
          "text": "Resources",
          "href": "/additive-manufacturing/resources.html",
          "expectedDestinationTitle": "Additive Manufacturing Resources"
        },
        {
          "text": "Contact",
          "href": "/additive-manufacturing/contact.html",
          "expectedDestinationTitle": "Contact Additive Manufacturing"
        }
      ],
      "footerLinks": [
        {
          "text": "Privacy Policy",
          "href": "/privacy-policy.html"
        },
        {
          "text": "Terms of Use",
          "href": "/terms-of-use.html"
        },
        {
          "text": "Contact Us",
          "href": "/contact.html"
        }
      ],
      "mainNavLinks": [
        {
          "text": "Home",
          "href": "/"
        },
        {
          "text": "Standards",
          "href": "/standards.html"
        },
        {
          "text": "Membership",
          "href": "/membership.html"
        },
        {
          "text": "News",
          "href": "/news.html"
        },
        {
          "text": "Help",
          "href": "/help.html"
        }
      ],
      "breadcrumbTrail": [
        {
          "text": "Home",
          "href": "/"
        },
        {
          "text": "Additive Manufacturing",
          "href": "/additive-manufacturing.html"
        }
      ],
      "edgeCases": [
        {
          "description": "Verify behavior when a link is broken (HTTP 404)",
          "link": "/additive-manufacturing/broken-link.html",
          "expected": "404 error page is displayed"
        },
        {
          "description": "Verify navigation when user is not logged in (if applicable)",
          "link": "/additive-manufacturing/resources.html",
          "expected": "Page loads without login prompt"
        },
        {
          "description": "Verify navigation with query parameters",
          "link": "/additive-manufacturing/overview.html?ref=test",
          "expected": "Page loads and query parameter is ignored or handled"
        }
      ],
      "boundaryCases": [
        {
          "description": "Test with maximum allowed URL length",
          "link": "/additive-manufacturing/overview.html?param=" + "a".repeat(2000),
          "expected": "Page loads or appropriate error is shown"
        },
        {
          "description": "Test with special characters in URL",
          "link": "/additive-manufacturing/overview.html?param=%20%21%40%23%24",
          "expected": "Page loads and special characters are handled"
        }
      ]
    },
    "ExpectedResult": "Page loads successfully with HTTP 200 and all UI elements are displayed"
  }
}
